datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  GROCERIES
  DINING
  GAS
  TRAVEL
}

enum PerkPeriod {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum ReminderType {
  PAYMENT_DUE
  PERK_ENDING
  ROTATING_CATEGORY
  POINTS_EXPIRY
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String                   @map("password_hash")
  name                    String
  timeZone                String                   @default("America/Los_Angeles") @map("time_zone")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  walletCards             WalletCard[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  programBalances         ProgramBalance[]

  @@map("users")
}

model RewardsProgram {
  id                String           @id @default(uuid())
  name              String           @unique
  centsPer100Points Int              @default(100) @map("cents_per_100_points")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  cards             Card[]
  programBalances   ProgramBalance[]

  @@map("rewards_programs")
}

model Card {
  id             String         @id @default(uuid())
  name           String         @unique
  issuer         String
  artColor       String         @map("art_color")
  isDemo         Boolean        @default(true) @map("is_demo")
  programId      String         @map("program_id")
  program        RewardsProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  annualFeeCents Int            @default(0) @map("annual_fee_cents")
  baseRateX100   Int            @default(100) @map("base_rate_x100")
  isRetired      Boolean        @default(false) @map("is_retired")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  rewardRules    RewardRule[]
  walletCards    WalletCard[]
  perks          Perk[]

  @@map("cards")
}

model RewardRule {
  id        String   @id @default(uuid())
  cardId    String   @map("card_id")
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  category  Category
  rateX100  Int      @map("rate_x100")
  capCents  Int?     @map("cap_cents")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cardId, category])
  @@map("reward_rules")
}

model Store {
  id        String       @id @default(uuid())
  name      String       @unique
  category  Category
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  aliases   StoreAlias[]

  @@map("stores")
}

model StoreAlias {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  alias     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, alias])
  @@map("store_aliases")
}

model WalletCard {
  id             String                    @id @default(uuid())
  userId         String                    @map("user_id")
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId         String                    @map("card_id")
  card           Card                      @relation(fields: [cardId], references: [id], onDelete: Restrict)
  nickname       String?
  openedDate     DateTime?                 @db.Date @map("opened_date")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  paymentSetting WalletCardPaymentSetting?
  paidCycles     WalletCardPaidCycle[]
  perkUsages     PerkUsage[]

  @@map("wallet_cards")
}

model WalletCardPaymentSetting {
  id           String     @id @default(uuid())
  walletCardId String     @unique @map("wallet_card_id")
  walletCard   WalletCard @relation(fields: [walletCardId], references: [id], onDelete: Cascade)
  dueDay       Int        @map("due_day")
  isAutopay    Boolean    @default(false) @map("is_autopay")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("wallet_card_payment_settings")
}

model WalletCardPaidCycle {
  id             String     @id @default(uuid())
  walletCardId   String     @map("wallet_card_id")
  walletCard     WalletCard @relation(fields: [walletCardId], references: [id], onDelete: Cascade)
  cycleYearMonth String     @map("cycle_year_month")
  paidAt         DateTime   @default(now()) @map("paid_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@unique([walletCardId, cycleYearMonth])
  @@map("wallet_card_paid_cycles")
}

model RateLimit {
  key       String   @id
  totalHits Int      @default(1) @map("total_hits")
  resetTime DateTime @map("reset_time")

  @@map("rate_limits")
}

model Notification {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ReminderType
  title       String
  body        String
  dueDate     DateTime     @db.Date @map("due_date")
  dedupeKey   String       @unique @map("dedupe_key")
  dismissedAt DateTime?    @map("dismissed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([userId, dismissedAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReminderType
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([userId, type])
  @@map("notification_preferences")
}

model ProgramBalance {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId     String         @map("program_id")
  program       RewardsProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  pointsBalance Int            @map("points_balance")
  expiryDate    DateTime       @db.Date @map("expiry_date")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([userId, programId])
  @@map("program_balances")
}

model Perk {
  id          String      @id @default(uuid())
  cardId      String      @map("card_id")
  card        Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  name        String
  amountCents Int         @map("amount_cents")
  period      PerkPeriod
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  usages      PerkUsage[]

  @@map("perks")
}

model PerkUsage {
  id           String     @id @default(uuid())
  walletCardId String     @map("wallet_card_id")
  walletCard   WalletCard @relation(fields: [walletCardId], references: [id], onDelete: Cascade)
  perkId       String     @map("perk_id")
  perk         Perk       @relation(fields: [perkId], references: [id], onDelete: Cascade)
  periodKey    String     @map("period_key")
  usedCents    Int        @default(0) @map("used_cents")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([walletCardId, perkId, periodKey])
  @@map("perk_usages")
}
