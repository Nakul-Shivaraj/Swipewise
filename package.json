{
  "name": "swipewise",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npm --workspace=@swipewise/api run db:migrate:deploy; fi && npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "design:theme": "node_modules\\.bin\\design.md.cmd export docs/DESIGN.md --format css-tailwind > apps/web/src/theme.css",
    "db:migrate": "npm --workspace=@swipewise/api run db:migrate",
    "db:seed": "npm --workspace=@swipewise/api run db:seed",
    "postinstall": "npm --workspace=@swipewise/api run postinstall",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@hookform/resolvers": "^6.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.20.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.5.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vitest": "3.0.5"
  },
  "overrides": {
    "jsdom": "25.0.1",
    "undici": "6.21.1"
  }
}
