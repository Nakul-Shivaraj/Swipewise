{
  "name": "swipewise",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.20.0",
    "prettier": "3.5.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vitest": "3.0.5"
  },
  "overrides": {
    "jsdom": "25.0.1",
    "undici": "6.21.1"
  }
}
